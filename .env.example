# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/agentforge

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Auth (Google OAuth is configured in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# LLM Provider: "gemini" or "mock" (mock requires no API key)
LLM_PROVIDER=gemini

# Groq request pacing and transient-error retries
GROQ_MAX_CONCURRENT_REQUESTS=2
GROQ_MAX_RETRIES=0
GROQ_RETRY_MAX_DELAY_SECONDS=60

# Web Research & Tools (Phase 2)
# Tavily API: Get key at https://tavily.com (or leave empty to use mock mode)
TAVILY_API_KEY=your-tavily-api-key-here
SEARCH_PROVIDER=tavily
AGENT_ENABLE_WEB_SEARCH=true
AGENT_ENABLE_CALCULATOR=true

# Agent & Tool Limits
MAX_TASKS=2
MAX_CONCURRENT_TASKS=2
# A final research/synthesis task runs after all planned tasks complete.
MAX_RETRIES=3
MAX_GOAL_LENGTH=2000
MAX_SEARCH_RESULTS=5
MAX_TOOL_CALLS_PER_TASK=1
MAX_TOOL_CALLS_PER_RUN=2
TOOL_TIMEOUT_SECONDS=8
AGENT_RUN_TIMEOUT_SECONDS=35
MAX_EXTRACTED_CHARS=8000

# Frontend (set these in frontend/.env.local for local development)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
